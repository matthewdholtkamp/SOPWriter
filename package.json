{
  "name": "sopwriter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "qa:docs": "vite-node scripts/generateQaDocs.ts",
    "stress:ask": "vite-node scripts/stressTestAskDrHoltkamp.ts",
    "test": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:watch": "vitest",
    "test:ui": "vitest run tests/ui.test.tsx"
  },
  "dependencies": {
    "docx": "9.7.1",
    "fflate": "^0.8.3",
    "pdfjs-dist": "6.0.227",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.2"
  },
  "devDependencies": {
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.7"
  }
